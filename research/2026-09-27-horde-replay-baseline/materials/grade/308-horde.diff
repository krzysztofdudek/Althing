+
+// ---------------------------------------------------------------------------
+// The key message names the source that will actually be used — computed
+// from the configuration as it stands after the write (overlay merged), not
+// from the environment alone. Before this, a stored yg-secrets.yaml key that
+// outranks the environment variable at run time was never mentioned: the
+// "No API key found" wording came from resolveReviewerConfigFromFlags, which
+// looks only at the env var, so it was flatly wrong whenever an overlay key
+// existed — including the key that a provider switch had just removed.
+// ---------------------------------------------------------------------------
+
+describe.skipIf(!distExists)('E2E — the key message names the source that will actually be used', () => {
+  const secretsPath = (dir: string): string => path.join(dir, '.yggdrasil', 'yg-secrets.yaml');
+
+  function runEnv(args: string[], cwd: string, env: NodeJS.ProcessEnv): Run {
+    const r = spawnSync('node', [BIN_PATH, ...args], { cwd, encoding: 'utf-8', env });
+    const stdout = r.stdout ?? '';
+    const stderr = r.stderr ?? '';
+    return { stdout, stderr, status: r.status, all: stdout + stderr };
+  }
+
+  function envWithout(...keys: string[]): NodeJS.ProcessEnv {
+    const env = { ...process.env };
+    for (const key of keys) delete env[key];
+    return env;
+  }
+
+  it('E1: switching provider away from a stored key names the removal, and the key value never reaches stdout', () => {
+    const dir = freshDir('key-msg-removed');
+    try {
+      expect(run(['init', '--platform', 'claude-code'], dir).status).toBe(0);
+      const bootstrap = runEnv(
+        ['init', '--provider', 'anthropic', '--model', 'claude-3-haiku'],
+        dir,
+        { ...process.env, ANTHROPIC_API_KEY: '<fake key: sk-ant-STALE>' },
+      );
+      expect(bootstrap.status).toBe(0);
+      expect(readFileSync(secretsPath(dir), 'utf-8')).toContain('sk-ant-STALE');
+
+      const switched = runEnv(
+        ['init', '--provider', 'openai-compatible', '--model', 'm', '--endpoint', 'http://127.0.0.1:9/v1'],
+        dir,
+        envWithout('OPENAI_COMPATIBLE_API_KEY'),
+      );
+      expect(switched.status).toBe(0);
+      expect(switched.all).toMatch(/removed from reviewer\.tiers\.standard\.config\.api_key/);
+      expect(switched.all).toContain('yg-secrets.yaml');
+      expect(switched.all).toContain('anthropic');
+      expect(switched.all).not.toContain('sk-ant-STALE');
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+
+  it('same provider, unset variable: names yg-secrets.yaml as the key source and prints no "No API key found" line', () => {
+    const dir = freshDir('key-msg-kept');
+    try {
+      expect(run(['init', '--platform', 'claude-code'], dir).status).toBe(0);
+      const bootstrap = runEnv(
+        ['init', '--provider', 'anthropic', '--model', 'claude-3-haiku'],
+        dir,
+        { ...process.env, ANTHROPIC_API_KEY: '<fake key: sk-ant-STALE>' },
+      );
+      expect(bootstrap.status).toBe(0);
+
+      const resame = runEnv(['init', '--provider', 'anthropic', '--model', 'other'], dir, envWithout('ANTHROPIC_API_KEY'));
+      expect(resame.status).toBe(0);
+      expect(resame.all).not.toContain('No API key found');
+      expect(resame.all).toContain('yg-secrets.yaml');
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+
+  it('same provider, variable set in the child env: today\'s behaviour is unchanged — the environment key is written into the overlay, no no-key warning is printed', () => {
+    const dir = freshDir('key-msg-new-key');
+    try {
+      expect(run(['init', '--platform', 'claude-code'], dir).status).toBe(0);
+      const bootstrap = runEnv(
+        ['init', '--provider', 'anthropic', '--model', 'claude-3-haiku'],
+        dir,
+        { ...process.env, ANTHROPIC_API_KEY: '<fake key: sk-ant-STALE>' },
+      );
+      expect(bootstrap.status).toBe(0);
+
+      const resame = runEnv(
+        ['init', '--provider', 'anthropic', '--model', 'other'],
+        dir,
+        { ...process.env, ANTHROPIC_API_KEY: '<fake key: sk-ant-FRESH>' },
+      );
+      expect(resame.status).toBe(0);
+      expect(resame.all).not.toContain('No API key found');
+      const secrets = parseYaml(readFileSync(secretsPath(dir), 'utf-8')) as { reviewer: { tiers: { standard: { config: { api_key: string } } } } };
+      expect(secrets.reviewer.tiers.standard.config.api_key).toBe('sk-ant-FRESH');
+    } finally {
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+});
