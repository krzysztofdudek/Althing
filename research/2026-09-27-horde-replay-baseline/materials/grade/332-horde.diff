+      // tree as it is, unversioned, rather than looking for a published tag.
+      rmSync(path.join(market, '.git'), { recursive: true, force: true });
+      const add = run(['pack', 'add', `${market}#demo`, '--as', 'acme/law'], consumerDir);
+
+      if (row.code === undefined) {
+        expect(check.status, check.all).toBe(0);
+        expect(add.status, add.all).toBe(0);
+        expect(
+          existsSync(path.join(consumerDir, '.yggdrasil', 'aspects', 'packages', 'acme', 'law', 'demo', 'example')),
+        ).toBe(true);
+      } else {
+        // A real install refusal, never a vacuous one from something else the
+        // mutation happened to break.
+        expect(add.status, add.all).not.toBe(0);
+        expect(add.all).toContain(row.word);
+        expect(check.status, check.all).not.toBe(0);
+        expect(check.all).toContain(row.code);
+        expect(check.all).toContain(row.word);
+      }
+    } finally {
+      rmSync(market, { recursive: true, force: true });
+      rmSync(consumerDir, { recursive: true, force: true });
+    }
+  });
 });
