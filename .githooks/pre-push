#!/bin/sh
# Althing's pre-push: the leak gate. CI runs too late in a public repository,
# so every commit about to leave this machine is scanned here: its message,
# its branch name, and the English, path, secret, binary and keyed names rails
# over every line it adds (a zero remote commit means the whole history). It
# refuses when this machine cannot run the names scan and the push goes to the
# canonical repository (git hands the hook the remote's URL as $2): nothing
# reaches it unscanned. A push to any other remote, such as a contributor's
# fork, prints one line saying it is unscanned and goes through.
exec node rails/run.mjs range --stdin --require-key --remote "$2"
