#!/bin/sh
# The family's leak gate for a tool repository: a template. The repository's
# maintainer installs it, on the owner's word, as the repository's pre-push
# hook, or calls it from the pre-push hook the repository already has, passing
# "$@" and the hook's standard input on. Althing never installs it.
#
# Before anything leaves this machine, Althing's keyed names rail reads every
# commit of the push: its message, its author, the lines it adds, the paths of
# the files it adds and the name of the pushed ref. A finding gives the commit,
# the file and the line, never the name. Only the commits the remote does not
# have yet are read, as its tracking refs here say. The rail runs from an Althing checkout
# on this machine: the one ALTHING_ROOT names, else the folder Althing beside
# this repository's main checkout.
#
# A push to a repository of the family that cannot be scanned (no Althing
# checkout, no Node, no names key) is refused: nothing reaches it unscanned. A
# push to any other remote, such as a contributor's fork, goes through with one
# line saying it is unscanned. The names key comes from the owner.
url="$2"
root="${ALTHING_ROOT:-}"
if [ -z "$root" ]; then
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && root="$(dirname "$(dirname "$common")")/Althing"
fi
if [ -n "$root" ] && [ -f "$root/workspace/ws.mjs" ] && command -v node >/dev/null 2>&1; then
  exec node "$root/workspace/ws.mjs" names --dir "$(git rev-parse --show-toplevel)" --stdin --remote "$url" --remote-name "$1"
fi
# The owner below is the one family/registry.json names; a URL git did not hand over counts as the family's.
case "$(printf '%s' "$url" | tr '[:upper:]' '[:lower:]')" in
  ''|*[/:]krzysztofdudek/*)
    echo "names: refused: this push goes to a repository of the family and cannot be scanned for private names here (no Althing checkout with Node on this machine; set ALTHING_ROOT to one). Nothing leaves the machine unscanned." >&2
    exit 1
    ;;
esac
echo "names: this push is unscanned for private names: this machine cannot run the scan, and the remote is not a repository of the family." >&2
exit 0
