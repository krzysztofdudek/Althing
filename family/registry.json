{
  "schema": "family-registry/1",
  "repos": {
    "runes": {
      "display": "Runes",
      "github": "krzysztofdudek/Runes",
      "kind": "shared",
      "build": ["npm ci", "npm run build", "npm run grammars"],
      "npm": "@chrisdudek/runes"
    },
    "yggdrasil": {
      "display": "Yggdrasil",
      "github": "krzysztofdudek/Yggdrasil",
      "kind": "core",
      "build": ["cd source/cli && npm ci && npm run build"],
      "bin": { "yg": "source/cli/dist/bin.js" },
      "env": { "YG_BIN": "{tree}/source/cli/dist/bin.js", "YGG_DIR": "{tree}" },
      "npm": "@chrisdudek/yg"
    },
    "grain": {
      "display": "Grain",
      "github": "krzysztofdudek/Grain",
      "kind": "core",
      "build": [],
      "bin": { "grain": "plugins/grain/bin/grain.mjs" },
      "plugin": "grain@grain-marketplace"
    },
    "jarl": {
      "display": "Jarl",
      "github": "krzysztofdudek/JarlSkill",
      "kind": "core",
      "build": [],
      "bin": { "jarl": "skills/jarl/scripts/jarl.mjs" },
      "plugin": "jarl@jarl-marketplace"
    },
    "horde": {
      "display": "Horde",
      "github": "krzysztofdudek/Horde",
      "kind": "retired",
      "left": "2026-11-04",
      "build": [],
      "note": "Left the family on 2026-11-04 (ruling horde-leaves-the-family); the repository is private. Kept here only because the 6.1.0 and 6.2.0 manifests list it."
    },
    "ratatoskr": {
      "display": "Ratatoskr",
      "github": "krzysztofdudek/RatatoskrSkill",
      "kind": "add-on",
      "build": [],
      "plugin": "ratatoskr@ratatoskr-marketplace"
    },
    "urd": {
      "display": "Urd",
      "github": "krzysztofdudek/UrdSkill",
      "kind": "add-on",
      "build": [],
      "plugin": "urd@urd-marketplace"
    },
    "researcher": {
      "display": "Researcher",
      "github": "krzysztofdudek/ResearcherSkill",
      "kind": "add-on",
      "build": [],
      "plugin": "researcher@researcher-marketplace"
    }
  },
  "retired": ["Horde"],
  "surfaces": {
    "profile": { "github": "krzysztofdudek/krzysztofdudek", "kind": "profile" },
    "website": { "url": "https://chrisdudek.com", "kind": "website" }
  }
}
